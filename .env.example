# 设置项示例。所有项都可以不填，括号里是默认值。
PORT=3000                 # 程序监听的端口（3000）
HOST=0.0.0.0              # 监听的地址（0.0.0.0 = 所有网卡）
BASE_PATH=                # 网站挂在哪个路径下，例如 /windtower（空 = 根目录）
TRUST_PROXY=false         # 放在 nginx 等反向代理后面时设为 true
QUESTIONS_FILE=questions.json  # 题库文件
QUESTIONS_PER_MATCH=15    # 对战每局题数（单人固定 8 题）
ANSWER_SECONDS=25         # 每题答题秒数
REVEAL_SECONDS=7          # 揭晓答案后停留秒数
MAX_PLAYERS_PER_ROOM=30   # 每个房间最多人数
